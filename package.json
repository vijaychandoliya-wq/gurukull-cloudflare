{
  "name": "gurukul-cloudflare-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Gurukul Platform Cloudflare Workers & Free Services Serverless Monorepo",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=workers/api run dev",
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "lint": "npm run --workspaces --if-present lint"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.6.3",
    "vite": "6.4.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
