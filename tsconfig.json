{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": [
    "packages/**/*.ts",
    "workers/**/*.ts",
    "tools/backup/src/**/*.ts",
    "tools/auth-probe/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "apps/portal", "tools/import"]
}
